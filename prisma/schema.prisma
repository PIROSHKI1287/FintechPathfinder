generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("user") // "user" | "admin"
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  consents DisclaimerConsent[]
  progress UserProgress[]
  attempts QuizAttempt[]

  @@map("users")
}

// ── Course（学習領域単位）──────────────────────────────────────────────────
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  modules     Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("courses")
}

// ── Module（旧 Level）─────────────────────────────────────────────────────
model Module {
  id          String  @id @default(cuid())
  courseId    String?
  course      Course? @relation(fields: [courseId], references: [id])
  slug        String  @default("")
  levelNumber Int     @unique
  title       String
  description String
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  units        Unit[]
  quizzes      Quiz[]
  storyPages   StoryPage[]
  userProgress UserProgress[]
  dictTerms    DictionaryTerm[]

  @@map("levels")
}

// ── Unit（座学セクション）─────────────────────────────────────────────────
model Unit {
  id       String   @id @default(cuid())
  moduleId String
  module   Module   @relation(fields: [moduleId], references: [id])
  type     UnitType
  order    Int
  title    String
  script   Json?

  quizzes Quiz[]

  @@map("units")
}

enum UnitType {
  LECTURE
  QUIZ
}

// ── StoryPage（後方互換保持）──────────────────────────────────────────────
model StoryPage {
  id          String  @id @default(cuid())
  levelId     String
  pageNumber  Int
  contentJson Json
  diagramUrl  String?

  module Module @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([levelId, pageNumber])
  @@map("story_pages")
}

// ── Quiz（旧 QuizQuestion）────────────────────────────────────────────────
model Quiz {
  id          String  @id @default(cuid())
  moduleId    String  @map("levelId")
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?   @relation(fields: [unitId], references: [id])
  question    String  @map("questionText")
  type        String  @default("SINGLE")
  explanation String?
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  options  QuizOption[]
  attempts QuizAttempt[]

  @@map("quiz_questions")
}

// ── QuizOption（旧 QuizChoice）────────────────────────────────────────────
model QuizOption {
  id              String  @id @default(cuid())
  quizId          String  @map("questionId")
  quiz            Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text            String  @map("choiceText")
  isCorrect       Boolean @default(false)
  order           Int     @default(0)
  complianceDelta Int     @default(0)
  gmvDelta        Int     @default(0)
  uxDelta         Int     @default(0)
  feedbackText    String?

  @@map("quiz_choices")
}

// ── UserProgress ──────────────────────────────────────────────────────────
model UserProgress {
  id              String    @id @default(cuid())
  userId          String
  courseId        String?
  moduleId        String    @map("levelId")
  status          String    // "in_progress" | "cleared" | "game_over"
  complianceScore Int       @default(100)
  gmvScore        Int       @default(0)
  uxScore         Int       @default(100)
  clearedAt       DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_progress")
}

// ── QuizAttempt ───────────────────────────────────────────────────────────
model QuizAttempt {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  chosenChoiceId  String?
  answeredAt      DateTime @default(now())
  complianceAfter Int
  gmvAfter        Int
  uxAfter         Int

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Quiz @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

// ── DictionaryTerm ────────────────────────────────────────────────────────
model DictionaryTerm {
  id             String   @id @default(cuid())
  term           String
  reading        String?
  definition     String
  relatedLevelId String?
  createdAt      DateTime @default(now())

  relatedLevel Module? @relation(fields: [relatedLevelId], references: [id])

  @@map("dictionary_terms")
}

model DisclaimerConsent {
  id          String   @id @default(cuid())
  userId      String
  consentedAt DateTime @default(now())
  ipAddress   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disclaimer_consents")
}
