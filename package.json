    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "next-auth": "^5.0.0-beta.19",
    "@auth/prisma-adapter": "^2.4.1",
    "@prisma/client": "^5.14.0",
    "jotai": "^2.8.3",
    "zod": "^3.23.8",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0",
